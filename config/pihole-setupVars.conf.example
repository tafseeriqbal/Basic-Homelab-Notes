# Pi-hole v5 reference only. v6 uses /etc/pihole/pihole.toml.
# Pi-hole configuration template.
# Fill in and place at /etc/pihole/setupVars.conf, or let the
# installer write it and diff against this.

PIHOLE_INTERFACE=REPLACE_IFACE
IPV4_ADDRESS=REPLACE_SERVER_IP/24
IPV6_ADDRESS=
QUERY_LOGGING=true
INSTALL_WEB_SERVER=true
INSTALL_WEB_INTERFACE=true
LIGHTTPD_ENABLED=true
CACHE_SIZE=10000
DNS_FQDN_REQUIRED=true
DNS_BOGUS_PRIV=true
DNSSEC=true
REV_SERVER=false
PIHOLE_DNS_1=1.1.1.1
PIHOLE_DNS_2=1.0.0.1
DNSMASQ_LISTENING=local
BLOCKING_ENABLED=true
